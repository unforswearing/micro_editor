{
    "colorscheme": "ryuuko",
    "column": 0,
    "css-formatter": "prettier",
    "cursorline": false,
    "fastdirty": true,
    "filemanager-compressparent": true,
    "filemanager-foldersfirst": true,
    "filemanager-openonstart": false,
    "filemanager-showdotfiles": true,
    "filemanager-showignored": true,
    "fmt-onsave": true,
    "hidehelp": false,
    "html-formatter": "html-tidy",
    "javascript-formatter": "prettier",
    "json-formatter": "prettier",
    "lua-formatter": "",
    "markdown-formatter": "cmark",
    "matchbraceleft": false,
    "mkparents": true,
    "pluginchannels": [
        "https://raw.githubusercontent.com/micro-editor/plugin-channel/master/channel.json"
    ],
    "pluginrepos": [],
    "python-formatter": "",
    "rmtrailingws": true,
    "ruby-formatter": "",
    "saveundo": true,
    "scrollbar": true,
    "scrollspeed": 1,
    "scss-formatter": "prettier",
    "shell-formatter": "shfmt",
    "softwrap": true,
    "statusformatl": "",
    "statusformatr": "$(filename) - $(modified)[$(line)/$(status.lines),$(col)]",
    "tabsize": 2,
    "tabstospaces": true,
    "termtitle": true,
    "trimdiff": false,
    "typescript-formatter": "prettier",
    "xml-formatter": "",
    "yaml-formatter": ""
}
